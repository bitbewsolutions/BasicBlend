---
import { Image } from 'astro:assets';
import Bolt from './Bolt.astro';
import SpecPlate from './SpecPlate.astro';
import type { CaseStudy } from '../data/work';

/**
 * A case study on the Work page: the delivered work beside its nameplate,
 * alternating sides down the page.
 *
 * The wipe reveal clips the INNER wrapper, never the observed <figure>.
 * Clipping the observed element itself leaves it with no visible area, so the
 * IntersectionObserver never fires and the image never appears — the bug the
 * first build shipped with.
 */
interface Props {
  study: CaseStudy;
  flip?: boolean;
}
const { study, flip = false } = Astro.props;
const href = `/work/${study.slug}/`;
---

<article class:list={['case', flip && 'case--flip']} aria-labelledby={`case-${study.slug}`}>
  <figure class="case__media plate" data-wipe>
    <a class="case__img-link" href={href} tabindex="-1" aria-hidden="true">
      <Image
        src={study.cover}
        alt={study.coverAlt}
        widths={[420, 640, 900, 1024]}
        sizes="(min-width: 1024px) 40rem, 92vw"
        loading="lazy"
        class="case__img"
      />
    </a>
  </figure>

  <div class="case__body">
    <p class="spec spec--sm spec--lit">{study.sector}</p>
    <h2 class="case__client display display--title" id={`case-${study.slug}`}>
      <a href={href}>{study.client}</a>
      {study.subBrand && <span class="case__sub">&amp; {study.subBrand}</span>}
    </h2>

    <p class="case__overview">{study.overview}</p>

    <h3 class="case__head spec spec--sm">What we did</h3>
    <ul class="case__scope bolt-list">
      {study.scope.map((s) => <li><Bolt />{s}</li>)}
    </ul>

    <SpecPlate rows={study.spec} />

    <!-- The accessible name starts with the visible text (WCAG 2.5.3, label in name). -->
    <a class="link-bolt case__more" href={href} aria-label={`View the full case: ${study.client}`}>
      <Bolt />View the full case
    </a>
  </div>
</article>

<style>
  .case { display: grid; gap: var(--s-6); align-items: start; }

  .case__media { margin: 0; padding: var(--s-2); }
  .case__img-link { display: block; overflow: hidden; }
  .case__img { width: 100%; height: auto; transition: transform 700ms var(--ease); }
  .case__img-link:hover .case__img { transform: scale(1.03); }

  .case__client { margin-top: var(--s-3); }
  .case__client a { text-decoration: none; transition: color var(--d-fast) var(--ease); }
  .case__client a:hover { color: var(--orange); }
  .case__sub { display: block; margin-top: var(--s-2); font-size: 0.6em; color: var(--cream-faint); }

  .case__overview { margin-block: var(--s-5) var(--s-6); color: var(--cream-dim); max-width: 54ch; }
  .case__head { margin-bottom: var(--s-4); }
  .case__scope { font-size: var(--t-small); margin-bottom: var(--s-6); }
  .case__more { margin-top: var(--s-6); }

  @media (min-width: 1024px) {
    .case { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: var(--s-9); align-items: center; }
    .case--flip .case__media { order: 2; }
  }
</style>
