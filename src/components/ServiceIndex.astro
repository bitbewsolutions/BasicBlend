---
import { services, groupServices } from '../data/services';

/**
 * Services as an index of full-row links — one row per service page, under a
 * label for each group (Brand & web, Growth marketing, Content & video).
 * `compact` (home): title + summary. `full` (services page): adds what's included.
 *
 * Heading levels assume the index sits under a section h2: groups are h3,
 * service titles h4.
 */
interface Props {
  variant?: 'compact' | 'full';
  /** Omit a service, e.g. the one whose page you are on. */
  exclude?: string;
}
const { variant = 'compact', exclude } = Astro.props;
const groups = groupServices(services.filter((s) => s.slug !== exclude));
let n = 0;
---

<div class:list={['svc', `svc--${variant}`]}>
  {groups.map((g) => (
    <section class="svc__group" aria-labelledby={`svc-${g.id}`}>
      <h3 class="svc__group-label spec spec--sm" id={`svc-${g.id}`}>
        {g.label}
      </h3>
      <ul>
        {g.services.map((s) => (
          <li data-reveal style={`--reveal-delay:${Math.min(n++, 6) * 50}ms`}>
            <a class="svc__row" href={`/services/${s.slug}/`}>
              <h4 class="svc__title display display--title">{s.title}</h4>
              <span class="svc__body">
                <span class="svc__summary">{s.summary}</span>
                {variant === 'full' && (
                  <span class="svc__items meta">{s.items.slice(0, 4).join(' / ')}</span>
                )}
              </span>
              <span class="svc__arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .svc { display: grid; gap: var(--s-8); }
  .svc__group-label {
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--rule-dark-strong);
    color: var(--cream);
  }
  .on-paper .svc__group-label { color: var(--ink); border-bottom-color: var(--rule-light-strong); }
  .svc li { border-bottom: 1px solid var(--rule-dark); }

  .svc__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 2rem;
    grid-template-areas: 'title arrow' 'body body';
    gap: var(--s-3) var(--s-4);
    padding-block: var(--s-6);
    text-decoration: none;
    color: inherit;
    isolation: isolate;
  }
  /* A purple wash slides in behind the row on hover. */
  .svc__row::before {
    content: '';
    position: absolute;
    inset: 0 calc(var(--gutter) * -0.5);
    background: var(--plum);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--d-mid) var(--ease);
    z-index: -1;
  }
  .svc__row:hover::before,
  .svc__row:focus-visible::before { transform: scaleY(1); }

  .svc__title { grid-area: title; transition: color var(--d-fast) var(--ease); }
  .svc__row:hover .svc__title { color: var(--orange); }

  .svc__body { grid-area: body; display: grid; gap: var(--s-2); max-width: 60ch; }
  .svc__summary { color: var(--cream-dim); }
  .svc__items { color: var(--cream-faint); }

  .svc__arrow {
    grid-area: arrow;
    justify-self: end;
    align-self: center;
    font-size: 1.4rem;
    color: var(--orange);
    transition: transform var(--d-mid) var(--ease);
  }
  .svc__row:hover .svc__arrow { transform: translateX(6px); }

  @media (min-width: 860px) {
    .svc__row {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr) 2.5rem;
      grid-template-areas: 'title body arrow';
      align-items: center;
      gap: var(--s-7);
    }
    .svc--full .svc__row { padding-block: var(--s-7); }
  }
</style>
