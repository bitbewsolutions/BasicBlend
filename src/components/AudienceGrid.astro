---
import { audiences } from '../data/services';

/** Who BasicBlend works with — every stage, product or service. */
---

<ul class="aud">
  {audiences.map((a, i) => (
    <li class="aud__item" data-reveal style={`--reveal-delay:${i * 70}ms`}>
      <span class="aud__rule" data-draw style={`--reveal-delay:${i * 70 + 100}ms`}></span>
      <h3 class="aud__title display display--title">{a.title}</h3>
      <p class="aud__body">{a.body}</p>
    </li>
  ))}
</ul>

<style>
  .aud { display: grid; gap: var(--s-6); }
  .aud__item { position: relative; display: grid; gap: var(--s-3); padding-top: var(--s-5); align-content: start; }
  .aud__rule { position: absolute; inset: 0 0 auto; height: 2px; background: var(--purple-ink); }
  .aud__title { font-size: clamp(1.5rem, 2.6vw, 2rem); }
  .aud__body { color: var(--ink-dim); max-width: 34ch; }

  @media (min-width: 640px) { .aud { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-7) var(--s-6); } }
  @media (min-width: 1100px) { .aud { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
