# Copy to .env and fill from Supabase → Project Settings → API keys.
# The two PUBLIC_ values also go into Netlify → Site configuration → Environment variables.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only, for scripts/. Never commit it and never put it in Netlify's build env.
SUPABASE_SECRET_KEY=sb_secret_...
