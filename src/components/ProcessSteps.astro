---
import type { Step } from '../data/services';

/**
 * Sequential steps with a connecting rule that draws as they enter.
 * Numbering is kept here because the steps genuinely happen in order.
 */
interface Props {
  steps: Step[];
}
const { steps } = Astro.props;
const cols = Math.min(steps.length, 4);
---

<ol class="steps" style={`--cols:${cols}`}>
  {steps.map((step, i) => (
    <li class="steps__item" data-reveal style={`--reveal-delay:${i * 80}ms`}>
      <span class="steps__line" data-draw style={`--reveal-delay:${i * 80 + 140}ms`}></span>
      <span class="steps__num spec" data-nums>{String(i + 1).padStart(2, '0')}</span>
      <h3 class="steps__title">{step.title}</h3>
      <p class="steps__body">{step.body}</p>
    </li>
  ))}
</ol>

<style>
  .steps { display: grid; gap: var(--s-7); }
  .steps__item { position: relative; display: grid; gap: var(--s-3); padding-top: var(--s-5); }
  .steps__line { position: absolute; inset: 0 0 auto; height: 2px; background: var(--rule-dark-strong); }
  .steps__item:first-child .steps__line { background: var(--orange); }
  :global(.on-paper) .steps__line { background: var(--rule-light-strong); }
  :global(.on-paper) .steps__item:first-child .steps__line { background: var(--orange-ink); }

  .steps__num { color: var(--orange); font-weight: 600; }
  :global(.on-paper) .steps__num { color: var(--orange-ink); }

  .steps__title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.35rem, 2.6vw, 1.75rem);
    text-transform: uppercase;
    letter-spacing: var(--track-display);
    line-height: 1.1;
  }
  .steps__body { color: var(--cream-dim); font-size: var(--t-small); max-width: 36ch; }
  :global(.on-paper) .steps__body { color: var(--ink-dim); }

  @media (min-width: 760px) {
    .steps { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: var(--s-5); }
  }
</style>
