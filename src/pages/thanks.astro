---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Bolt from '../components/Bolt.astro';
import { site, whatsappLink } from '../data/site';

const next = [
  { title: 'We read it', body: 'We look at your business and anything you already have running.' },
  { title: 'We reply', body: 'With questions, or a first view of how we would approach it.' },
  { title: 'We plan', body: 'If it is a fit, we agree the scope, timing and cost together.' },
];
---

<Base
  title={`Thanks — we have your enquiry | ${site.name}`}
  description="Your enquiry has reached BasicBlend."
  noindex
  conversion="lead"
>
  <PageHero
    title="Got it. Thanks."
    lead="Your enquiry has reached us and we will be in touch. If it is urgent, WhatsApp is the quickest way to reach us."
    crumbs={[{ label: 'Enquiry received' }]}
  >
    <div class="btn-row">
      <a class="btn" href={whatsappLink('Hi BasicBlend — I just sent an enquiry through your site.')} target="_blank" rel="noopener noreferrer">
        <Bolt />Message on WhatsApp
      </a>
      <a class="btn btn--ghost" href="/work/">Browse our work</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="next-title">
    <div class="shell">
      <h2 class="display display--title thanks__h" id="next-title" data-stamp>What happens next</h2>
      <ProcessSteps steps={next} />
    </div>
  </section>
</Base>

<style>
  .thanks__h { margin-bottom: var(--s-7); }
</style>
