---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceIndex from '../../components/ServiceIndex.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import CaseCard from '../../components/CaseCard.astro';
import IdentityGrid from '../../components/IdentityGrid.astro';
import FilmRow from '../../components/FilmRow.astro';
import CtaBand from '../../components/CtaBand.astro';
import Bolt from '../../components/Bolt.astro';
import { services, type Service } from '../../data/services';
import { getCaseStudies, getFilms } from '../../lib/content';
import { site, SITE_URL, whatsappLink } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service } = Astro.props;

// Real work shown only where it genuinely exists for this service.
const relatedCases = (await getCaseStudies()).filter((c) => c.services.includes(service.slug));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.intro,
  serviceType: service.title,
  provider: { '@id': `${SITE_URL}/#business` },
  areaServed: [
    ...site.areaServed.map((name) => ({ '@type': 'City', name })),
    { '@type': 'Country', name: 'India' },
  ],
  url: `${SITE_URL}/services/${service.slug}/`,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: service.title,
    itemListElement: service.items.map((name) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name },
    })),
  },
};
---

<Base
  title={`${service.seoTitle} | BasicBlend`}
  description={service.metaDescription}
  keywords={service.keywords}
  schema={schema}
>
  <PageHero
    title={service.title}
    lead={service.intro}
    crumbs={[{ label: 'Services', href: '/services/' }, { label: service.title }]}
  >
    <div class="btn-row">
      <a class="btn" href={`/contact/?service=${service.slug}`}>
        Start a project <span class="btn__arrow" aria-hidden="true">&rarr;</span>
      </a>
      <a
        class="btn btn--ghost"
        href={whatsappLink(`Hi BasicBlend — I'd like to talk about ${service.title}.`)}
        target="_blank"
        rel="noopener noreferrer"
      ><Bolt />WhatsApp</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="included-title">
    <div class="shell svc-detail">
      <div class="svc-detail__included">
        <h2 class="display display--title" id="included-title" data-stamp>What's included</h2>
        <ul class="bolt-list svc-detail__items">
          {service.items.map((item, i) => (
            <li data-reveal style={`--reveal-delay:${i * 50}ms`}><Bolt />{item}</li>
          ))}
        </ul>
      </div>

      <aside class="svc-detail__fit plate plate--inset" aria-labelledby="fit-title" data-reveal>
        <h2 class="spec spec--sm spec--lit" id="fit-title">A good fit for</h2>
        <ul class="svc-detail__fits">
          {service.fits.map((fit) => <li>{fit}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  {service.proof === 'identity' && (
    <section class="section on-plum" aria-labelledby="proof-title">
      <div class="shell">
        <SectionHead label="Work" id="proof-title" title="Identities we have designed" align="wide" />
        <IdentityGrid />
      </div>
    </section>
  )}

  {service.proof === 'films' && (
    <section class="section on-plum" aria-labelledby="proof-title">
      <div class="shell">
        <SectionHead
          label="Work"
          id="proof-title"
          title="Made by our team"
          lead="Production films and behind-the-scenes footage from recent shoots."
          align="wide"
        />
        <FilmRow films={await getFilms()} />
      </div>
    </section>
  )}

  {relatedCases.length > 0 && service.proof !== 'films' && service.proof !== 'identity' && (
    <section class="section on-plum" aria-labelledby="proof-title">
      <div class="shell">
        <SectionHead label="Work" id="proof-title" title="Related work" align="wide" />
        <div class:list={['svc-cases', relatedCases.length === 1 && 'svc-cases--single']}>
          {relatedCases.map((study, i) => <CaseCard study={study} delay={i * 90} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="steps-title">
    <div class="shell">
      <SectionHead label="Process" id="steps-title" title="How it runs" align="wide" />
      <ProcessSteps steps={service.steps} />
    </div>
  </section>

  <section class="section" aria-labelledby="other-title">
    <div class="shell">
      <SectionHead label="Services" id="other-title" title="Other services" align="wide" />
      <ServiceIndex exclude={service.slug} />
    </div>
  </section>

  <CtaBand
    title={`Talk to us about ${service.short}`}
    message={`Hi BasicBlend — I'd like to talk about ${service.title}.`}
  />
</Base>

<style>
  .svc-detail { display: grid; gap: var(--s-8); align-items: start; }
  .svc-detail__items { margin-top: var(--s-6); font-size: var(--t-body-lg); }
  .svc-detail__fit { padding: var(--s-6); }
  .svc-detail__fits { display: grid; gap: var(--s-4); margin-top: var(--s-5); }
  .svc-detail__fits li { padding-top: var(--s-4); border-top: 1px solid var(--rule-dark); color: var(--cream); }
  .svc-detail__fits li:first-child { border-top: 0; padding-top: 0; }

  .svc-cases { display: grid; gap: var(--s-8); }

  @media (min-width: 760px) {
    .svc-detail__items { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s-6); }
    .svc-cases { grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: var(--s-6); }
    /* One case alone would stretch to the full shell; keep it at card size. */
    .svc-cases--single { grid-template-columns: minmax(0, 36rem); }
  }
  @media (min-width: 1024px) {
    .svc-detail { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--s-9); }
  }
</style>
