---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Blend from '../components/sections/Blend.astro';
import SectionHead from '../components/SectionHead.astro';
import AudienceGrid from '../components/AudienceGrid.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import CaseCard from '../components/CaseCard.astro';
import Filmstrip from '../components/Filmstrip.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import CtaBand from '../components/CtaBand.astro';
import Bolt from '../components/Bolt.astro';
import { process } from '../data/services';
import { caseStudies } from '../data/work';

/**
 * The home page is a summary with exits, not the whole site. Each section
 * gives just enough to decide, then hands off to its dedicated page:
 * services → /services, work → /work and case pages, process → /about,
 * the form → /contact.
 */
const [featured, ...rest] = caseStudies;
---

<Base title="Basic Blend — Digital Marketing Agency in Chandigarh | BasicBlend">
  <Hero />
  <Blend />

  <section class="section on-paper" aria-labelledby="who-title">
    <div class="shell">
      <SectionHead
        label="Who we work with"
        id="who-title"
        title="Any business with something to build"
        lead="New or established, selling a product or a service. The work changes with your stage; the standard does not."
        align="wide"
      />
      <AudienceGrid />
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="shell">
      <SectionHead
        label="Services"
        id="services-title"
        title="Everything a brand needs to grow"
        lead="Take one service or hand us the whole blend. One team means nothing gets lost between a designer, a developer and an ad agency."
        align="wide"
      />
      <ServiceIndex />
      <p class="home__more"><a class="link-bolt" href="/services/"><Bolt />All services in detail</a></p>
    </div>
  </section>

  <section class="section on-plum home-work" aria-labelledby="work-title">
    <div class="shell">
      <SectionHead
        label="Work"
        id="work-title"
        title="Selected work"
        lead="A few recent projects. Each case shows the work itself: the posts, the films and the thinking behind them."
        align="wide"
      />
      <div class="home-work__grid">
        <CaseCard study={featured} size="large" />
        <div class="home-work__pair">
          {rest.map((study, i) => <CaseCard study={study} delay={(i + 1) * 90} />)}
        </div>
      </div>
      <div class="btn-row home__more">
        <a class="btn" href="/work/">See all work <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <Filmstrip />

  <section class="section" aria-labelledby="process-title">
    <div class="shell">
      <SectionHead
        label="Process"
        id="process-title"
        title="How a project runs"
        lead="Four steps, the same on every project. You always know what is being worked on and why."
        align="wide"
      />
      <ProcessSteps steps={process} />
      <p class="home__more"><a class="link-bolt" href="/about/"><Bolt />More about how we work</a></p>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .home__more { margin-top: var(--s-7); }

  .home-work__grid { display: grid; gap: var(--s-8); }
  .home-work__pair { display: grid; gap: var(--s-8); }
  @media (min-width: 760px) {
    .home-work__pair { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6); }
  }
</style>
